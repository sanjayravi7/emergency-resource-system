generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  REQUESTER
  RESPONDER
  ADMIN
}

enum ResponderStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  PARTIALLY_ALLOCATED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum AllocationStatus {
  RESERVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

// ======================================================
// USER
// Created LIVE by the application
// ======================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?

  role UserRole @default(REQUESTER)

  isActive     Boolean   @default(true)
  lastActiveAt DateTime?

  latitude  Float?
  longitude Float?

  responderStatus ResponderStatus @default(OFFLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests EmergencyRequest[]

  allocations Allocation[] @relation("ResponderAllocations")

  responderResources ResponderResource[]
}

// ======================================================
// EMERGENCY REQUEST
// Created LIVE by users
// ======================================================

model EmergencyRequest {
  id Int @id @default(autoincrement())

  requesterId Int

  emergencyType String
  description   String

  location String

  latitude  Float?
  longitude Float?

  priority Priority @default(MEDIUM)

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation(fields: [requesterId], references: [id])

  requiredResources RequestResource[]

  allocations Allocation[]

  @@index([requesterId])
  @@index([status])
  @@index([priority])
  @@index([location])
}

// ======================================================
// RESOURCE
// Predefined resource types
//
// Example:
// Ambulance
// Fire Truck
// Oxygen Cylinder
// First Aid Kit
// Rescue Vehicle
// ======================================================

model Resource {
  id Int @id @default(autoincrement())

  name String  @unique
  type String
  unit String?

  createdAt DateTime @default(now())

  requiredIn RequestResource[]

  responderResources ResponderResource[]

  allocations Allocation[]
}

// ======================================================
// RESPONDER RESOURCE
//
// LIVE inventory belonging to a responder.
//
// Example:
//
// Responder: Rahul
// Resource: Ambulance
// Total: 2
// Available: 1
// ======================================================

model ResponderResource {
  id Int @id @default(autoincrement())

  responderId Int
  resourceId  Int

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)

  status ResourceStatus @default(UNAVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responder User @relation(fields: [responderId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  allocations Allocation[]

  @@unique([responderId, resourceId])
  @@index([responderId])
  @@index([resourceId])
  @@index([status])
}

// ======================================================
// RESOURCES REQUIRED BY AN EMERGENCY
//
// Example:
//
// Emergency #10
// Ambulance = 1
// Oxygen Cylinder = 2
// ======================================================

model RequestResource {
  id Int @id @default(autoincrement())

  requestId  Int
  resourceId Int
  quantity   Int

  request EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([requestId, resourceId])
  @@index([requestId])
  @@index([resourceId])
}

// ======================================================
// ALLOCATION
//
// Created LIVE when a responder/resource is assigned
// to an emergency.
// ======================================================

model Allocation {
  id Int @id @default(autoincrement())

  requestId Int

  responderResourceId Int

  responderId Int

  resourceId Int

  quantity Int

  status AllocationStatus @default(RESERVED)

  allocatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request EmergencyRequest @relation(fields: [requestId], references: [id])

  responderResource ResponderResource @relation(fields: [responderResourceId], references: [id])

  responder User @relation("ResponderAllocations", fields: [responderId], references: [id])

  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([requestId])
  @@index([responderResourceId])
  @@index([responderId])
  @@index([resourceId])
  @@index([status])
}
