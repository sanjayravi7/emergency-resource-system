generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  REQUESTER
  RESPONDER
  ADMIN
}

enum ResponderStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  PARTIALLY_ALLOCATED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum AllocationStatus {
  RESERVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

// ======================================================
// USER
// ======================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?

  role UserRole @default(REQUESTER)

  isActive     Boolean   @default(true)
  lastActiveAt DateTime?

  location  String?
  latitude  Float?
  longitude Float?

  responderStatus ResponderStatus @default(OFFLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests EmergencyRequest[]

  allocations Allocation[] @relation("ResponderAllocations")

  responderResources ResponderResource[]

  acceptedRequests EmergencyRequest[] @relation("AcceptedRequests")
}

// ======================================================
// EMERGENCY REQUEST
// ======================================================

model EmergencyRequest {
  id Int @id @default(autoincrement())

  requesterId Int

  emergencyType String
  description   String

  location String

  latitude  Float?
  longitude Float?

  priority Priority @default(MEDIUM)

  status RequestStatus @default(PENDING)

  acceptedById Int?
  acceptedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation(fields: [requesterId], references: [id])

  acceptedBy User? @relation("AcceptedRequests", fields: [acceptedById], references: [id])

  requiredResources RequestResource[]

  allocations Allocation[]

  @@index([requesterId])
  @@index([status])
  @@index([priority])
  @@index([location])
  @@index([acceptedById])
}

// ======================================================
// RESOURCE
//
// Master/resource inventory.
// Example:
// Ambulance
// Fire Truck
// Oxygen Cylinder
// First Aid Kit
// ======================================================

model Resource {
  id Int @id @default(autoincrement())

  name String @unique
  type String

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)

  unit     String?
  location String?

  // Active/inactive state. Inactive resources stay in the database
  // (history is preserved) but are hidden from requesters.
  isActive Boolean @default(true)

  // Low-stock visibility: a resource is "low stock" when
  // availableQuantity <= lowStockThreshold.
  lowStockThreshold Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredIn RequestResource[]

  responderResources ResponderResource[]

  allocations Allocation[]

  @@index([type])
  @@index([location])
  @@index([isActive])
}

// ======================================================
// RESPONDER RESOURCE
//
// Actual resource assigned to a particular responder.
//
// Example:
// Responder = Rahul
// Resource = Ambulance
// Total = 2
// Available = 1
// Status = BUSY
// ======================================================

model ResponderResource {
  id Int @id @default(autoincrement())

  responderId Int
  resourceId  Int

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)

  status ResourceStatus @default(UNAVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responder User @relation(fields: [responderId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  allocations Allocation[]

  @@unique([responderId, resourceId])
  @@index([responderId])
  @@index([resourceId])
  @@index([status])
}

// ======================================================
// RESOURCES REQUIRED BY AN EMERGENCY
// ======================================================

model RequestResource {
  id Int @id @default(autoincrement())

  requestId  Int
  resourceId Int
  quantity   Int

  request EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([requestId, resourceId])
  @@index([requestId])
  @@index([resourceId])
}

// ======================================================
// ALLOCATION
//
// Connects:
// Emergency Request
// + Responder
// + Resource
// + Quantity
// ======================================================

model Allocation {
  id Int @id @default(autoincrement())

  requestId           Int
  resourceId          Int
  responderId         Int
  responderResourceId Int

  quantity Int

  status AllocationStatus @default(RESERVED)

  allocatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request EmergencyRequest @relation(fields: [requestId], references: [id])

  resource Resource @relation(fields: [resourceId], references: [id])

  responder User @relation("ResponderAllocations", fields: [responderId], references: [id])

  responderResource ResponderResource @relation(fields: [responderResourceId], references: [id])

  @@index([requestId])
  @@index([resourceId])
  @@index([responderId])
  @@index([responderResourceId])
  @@index([status])
}
