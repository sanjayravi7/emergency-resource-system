generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  REQUESTER
  RESPONDER
  ADMIN
}

enum ResponderStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  PARTIALLY_ALLOCATED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

// How an ERAS account was originally created. PASSWORD keeps the historical
// email/password flow; GOOGLE marks accounts provisioned through a verified
// Google/Firebase identity. The column is informational: authorization always
// comes from UserRole + isActive, never from the provider.
enum AuthProvider {
  PASSWORD
  GOOGLE
}

// Purpose of a one-time, hashed, short-lived code (never stored in plaintext).
// EMAIL_VERIFICATION confirms ownership of an email address after public
// registration; PASSWORD_RESET drives the 6-digit password reset flow.
enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// SERVICE resources (e.g. Ambulance, Volunteer, Fire Resource, Rescue Boat)
// are reusable responder capabilities. CONSUMABLE resources (e.g. Blood,
// Oxygen, Water, Medicine) are spent from inventory. Business logic must
// branch on this column and never infer mode from a resource name.
enum ResourceMode {
  SERVICE
  CONSUMABLE
}

enum AllocationStatus {
  RESERVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Membership state of one responder on one emergency. ACTIVE while they are
// working the emergency, ENDED once their involvement is over (request
// completed/cancelled, or the assignment is removed).
enum AssignmentStatus {
  ACTIVE
  ENDED
}

// Canonical emergency categories used for responder eligibility. These are
// deliberately independent from Resource/ResponderResource inventory.
enum EmergencyCategory {
  FIRE
  MEDICAL
  ACCIDENT
  FLOOD
  RESCUE
  OTHER
}

// ======================================================
// USER
// ======================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?

  role UserRole @default(REQUESTER)

  isActive     Boolean   @default(true)
  lastActiveAt DateTime?

  // Email verification state. Google/Firebase identities are already verified
  // by the provider and are stored as verified; email/password registrations
  // start unverified until the ERAS verification code is confirmed.
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Durable at-most-once claim for the ERAS welcome-email attempt. Set in the
  // same database operation that verifies a password account, or on creation
  // of a new Google account, before any external provider request is made.
  // This prevents duplicate sends across workers, retries and restarts.
  welcomeEmailDispatchClaimedAt DateTime?

  // Account origin (informational only - never an authorization input).
  authProvider AuthProvider @default(PASSWORD)

  // Stable Google/Firebase subject identifier. Unique so one Google identity
  // can only ever map to one ERAS account; NULL for password-only accounts.
  firebaseUid String? @unique

  // Sessions issued before this instant are rejected. Set on password
  // reset/change so previously issued JWTs cannot be reused.
  passwordChangedAt DateTime?

  location  String?
  latitude  Float?
  longitude Float?

  responderStatus ResponderStatus @default(OFFLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests EmergencyRequest[]

  authCodes AuthCode[]
  auditLogs AuditLog[] @relation("AuditActor")

  allocations Allocation[] @relation("ResponderAllocations")

  responderResources ResponderResource[]
  responderHelpTypes ResponderHelpType[]

  acceptedRequests     EmergencyRequest[]    @relation("AcceptedRequests")
  responderAssignments ResponderAssignment[]

  // FCM push targets for this user (responders register one row per installed
  // device). Tokens are transport metadata only: the EmergencyRequest row
  // stays the single source of truth and no notification state is derived
  // from them.
  deviceTokens PushDeviceToken[]
}

// ======================================================
// PUSH DEVICE TOKEN
//
// One FCM registration token per installed client. A responder may hold
// several rows (phone + tablet). Tokens are registered by the authenticated
// responder through POST /api/responders/device-tokens and removed on logout
// or when FCM reports them unregistered. They never carry lifecycle state -
// a missing push can never lose an emergency request.
// ======================================================

model PushDeviceToken {
  id Int @id @default(autoincrement())

  userId Int
  token String @unique

  // Optional client hint (e.g. "android", "ios", "web"). Display/debug only.
  platform String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Refreshed whenever the device re-registers, so stale rows are visible.
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======================================================
// AUTH CODE (one-time, hashed, short-lived)
//
// Drives email verification and the 6-digit password reset code. The plaintext
// code exists only in memory/the outgoing ERAS email; PostgreSQL stores a
// bcrypt hash. Rows are single use (consumedAt), expire quickly (expiresAt),
// are attempt limited (attempts/maxAttempts) and are invalidated when a newer
// code for the same (user, purpose) is issued.
// ======================================================

model AuthCode {
  id Int @id @default(autoincrement())

  userId  Int
  purpose AuthCodePurpose

  codeHash String

  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  consumedAt  DateTime?

  // Throttling bookkeeping: when this code was (re)issued. Enforces the
  // resend cooldown without needing an extra table.
  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ======================================================
// AUDIT LOG
//
// Append-only security/operational audit trail. Rows are written by
// auditLogService only and are NEVER removed by the after-action log deletion
// feature (that feature archives the request row and records a new
// ADMIN_DELETED_LOG event here). Deliberately stores no secrets: no
// passwords, no reset codes, no tokens.
// ======================================================

model AuditLog {
  id Int @id @default(autoincrement())

  event String

  actorId   Int?
  actorRole String?

  targetType String?
  targetId   String?

  ip String?

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([actorId])
  @@index([createdAt])
}

// ======================================================
// EMERGENCY REQUEST
// ======================================================

model EmergencyRequest {
  id Int @id @default(autoincrement())

  requesterId Int

  emergencyType String
  description   String?

  location String

  latitude  Float?
  longitude Float?

  priority Priority @default(MEDIUM)

  status RequestStatus @default(PENDING)

  acceptedById Int?
  acceptedAt   DateTime?

  // Backend-authoritative expiry for UNATTENDED emergencies. expiresAt is
  // generated by the server from the central expiry policy when the request is
  // created, so expiry survives restarts/sleeps and never depends on a
  // frontend timer. Attended/lifecycle-progressed requests are protected: the
  // expiry service only cancels requests that are still PENDING with no active
  // assignment/allocation, and any responder activity clears expiresAt.
  expiresAt DateTime?

  // Set when the request was actually expired by the expiry service (audit);
  // the row keeps its status CANCELLED, which is the existing terminal state.
  expiredAt DateTime?

  // After-action log archival. Archived requests are hidden from the visible
  // ERAS log but preserved for history/audit (no data is destroyed).
  archivedAt   DateTime?
  archivedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation(fields: [requesterId], references: [id])

  acceptedBy User? @relation("AcceptedRequests", fields: [acceptedById], references: [id])

  requiredResources RequestResource[]

  allocations Allocation[]
  assignments ResponderAssignment[]

  @@index([requesterId])
  @@index([status])
  @@index([priority])
  @@index([location])
  @@index([acceptedById])
  @@index([status, expiresAt])
  @@index([archivedAt])
}

// ======================================================
// RESPONDER ASSIGNMENT
//
// Connects:
// Emergency Request
// + Responder (User)
//
// One row per (request, responder) pair: the unique constraint prevents
// duplicate assignments, while multiple responders may be assigned to the
// same emergency and one responder may hold assignments on multiple
// emergencies. EmergencyRequest.acceptedById continues to identify the
// FIRST accepting (lead) responder for backward compatibility and is never
// overwritten when additional responders join.
// ======================================================

model ResponderAssignment {
  id Int @id @default(autoincrement())

  requestId   Int
  responderId Int

  status AssignmentStatus @default(ACTIVE)

  acceptedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request   EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder User             @relation(fields: [responderId], references: [id])

  @@unique([requestId, responderId])
  @@index([requestId, status])
  @@index([responderId, status])
}

// ======================================================
// RESOURCE
//
// Master/resource inventory.
// Example:
// Ambulance
// Fire Truck
// Oxygen Cylinder
// First Aid Kit
// ======================================================

model Resource {
  id Int @id @default(autoincrement())

  name String @unique
  type String

  // Defaults to CONSUMABLE so every existing resource keeps its current
  // inventory-driven behaviour. totalQuantity and availableQuantity remain
  // required for CONSUMABLE inventory tracking; SERVICE resources are
  // reusable responder capabilities and are not decremented on allocation.
  mode ResourceMode @default(CONSUMABLE)

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)

  unit     String?
  location String?

  // Active/inactive state. Inactive resources stay in the database
  // (history is preserved) but are hidden from requesters.
  isActive Boolean @default(true)

  // Low-stock visibility: a resource is "low stock" when
  // availableQuantity <= lowStockThreshold.
  lowStockThreshold Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredIn RequestResource[]

  responderResources ResponderResource[]

  allocations Allocation[]

  @@index([type])
  @@index([location])
  @@index([isActive])
}

// ======================================================
// RESPONDER HELP TYPE
//
// Durable emergency-category eligibility. This is intentionally not linked
// to Resource: inventory may be empty or unavailable without erasing what a
// responder is willing or qualified to handle.
// ======================================================

model ResponderHelpType {
  id Int @id @default(autoincrement())

  responderId Int
  category EmergencyCategory
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responder User @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([responderId, category])
  @@index([responderId, enabled])
  @@index([category, enabled])
}

// ======================================================
// RESPONDER RESOURCE
//
// Actual resource assigned to a particular responder.
//
// Example:
// Responder = Rahul
// Resource = Ambulance
// Total = 2
// Available = 1
// Status = BUSY
// ======================================================

model ResponderResource {
  id Int @id @default(autoincrement())

  responderId Int
  resourceId  Int

  totalQuantity     Int @default(0)
  availableQuantity Int @default(0)

  // A responder's durable willingness/qualification for this resource.
  // `status` represents current availability only and is not a capability flag.
  isEnabled Boolean @default(false)

  status ResourceStatus @default(UNAVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responder User @relation(fields: [responderId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  allocations Allocation[]

  @@unique([responderId, resourceId])
  @@index([responderId])
  @@index([resourceId])
  @@index([status])
}

// ======================================================
// RESOURCES REQUIRED BY AN EMERGENCY
// ======================================================

model RequestResource {
  id Int @id @default(autoincrement())

  requestId  Int
  resourceId Int
  quantity   Int

  request EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([requestId, resourceId])
  @@index([requestId])
  @@index([resourceId])
}

// ======================================================
// ALLOCATION
//
// Connects:
// Emergency Request
// + Responder
// + Resource
// + Quantity
// ======================================================

model Allocation {
  id Int @id @default(autoincrement())

  requestId           Int
  resourceId          Int
  responderId         Int
  responderResourceId Int

  quantity Int

  status AllocationStatus @default(RESERVED)

  allocatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request EmergencyRequest @relation(fields: [requestId], references: [id])

  resource Resource @relation(fields: [resourceId], references: [id])

  responder User @relation("ResponderAllocations", fields: [responderId], references: [id])

  responderResource ResponderResource @relation(fields: [responderResourceId], references: [id])

  @@index([requestId])
  @@index([resourceId])
  @@index([responderId])
  @@index([responderResourceId])
  @@index([status])
}
