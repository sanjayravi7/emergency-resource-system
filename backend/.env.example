# ERAS backend environment template.
# Copy to backend/.env and fill in real values. .env is git-ignored.
# NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eras?schema=public"

# JWT signing secret.
#   * REQUIRED in every environment (startup fails if missing).
#   * In production it MUST be strong: >= 32 characters and not a known
#     default. Startup THROWS in production for a weak/default secret.
#     Generate one with:  openssl rand -base64 48
#   * Outside production a weak secret only logs a warning (dev convenience).
JWT_SECRET="change-me"

JWT_EXPIRES_IN="7d"
PORT=5000

# NODE_ENV controls production hardening (strong-secret enforcement, JSON log
# format, default trust-proxy). Set to "production" for real deployments.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# HTTP hardening (all optional; safe defaults shown)
# ---------------------------------------------------------------------------
# CORS allowlist. Unset (or "*") reflects any origin, preserving the historical
# same-origin Flutter web + native client behaviour. In production, set an
# explicit comma-separated allowlist. Applies to REST and Socket.IO.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Reverse-proxy hop configuration for correct client IPs (rate limiting).
# Defaults to 1 in production and off in development. Accepts a boolean, a hop
# count, or a subnet/keyword (e.g. "loopback").
# TRUST_PROXY=1

# Maximum accepted JSON request body. Oversized bodies get a 413.
# JSON_BODY_LIMIT=100kb

# ---------------------------------------------------------------------------
# Rate limiting (auth + abusive traffic only)
# GPS/heartbeat/location endpoints are deliberately EXCLUDED so emergency
# dispatch and live location streaming are never throttled.
# ---------------------------------------------------------------------------
# RATE_LIMIT_ENABLED defaults to true, except under NODE_ENV=test.
# RATE_LIMIT_ENABLED=true
# AUTH_RATE_WINDOW_MS=900000     # 15 minutes
# AUTH_RATE_MAX=30               # login/register attempts per IP per window
# API_RATE_WINDOW_MS=60000       # 1 minute
# API_RATE_MAX=600               # general API requests per IP per window

# ---------------------------------------------------------------------------
# Navigation: ERAS does NOT compute driving routes.
#
# The operational map draws a simple direct connection line between the
# responder and the emergency (local map geometry only), and real driving
# directions are delegated to Google Maps via a universal Maps URL
# (https://www.google.com/maps/dir/?api=1). That URL requires no API key, so
# no server-side Google Routes key is needed anywhere in ERAS.
#
# The browser Maps JavaScript / Places (New) key lives in
# frontend/emergency_app/web/google_maps_config.js, not here. It is a
# BROWSER key and must be HTTP-referrer restricted (see GOOGLE_MAPS_SETUP.md /
# web/google_maps_config.template.js).
# ---------------------------------------------------------------------------

# Optional Socket.IO tuning (defaults shown).
# SOCKET_LOCATION_PERSIST_INTERVAL_MS=10000
# SOCKET_LOCATION_RATE_WINDOW_MS=1000
# SOCKET_LOCATION_MAX_UPDATES_PER_WINDOW=10
# SOCKET_SESSION_REVALIDATE_MS=30000

# ---------------------------------------------------------------------------
# Google Sign-In identity verification + email verification/reset (production)
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT_ID must match Firebase Web, Android, the service account,
# and the `aud` of the Firebase ID tokens sent by the Flutter client.
# FIREBASE_PROJECT_ID=your-firebase-project-id
#
# Provide the Firebase Admin service account either inline (Render secret) or
# as a secret file. It needs Firebase Authentication token-verification access.
# Existing FCM_SERVICE_ACCOUNT / FCM_SERVICE_ACCOUNT_FILE values are accepted
# as a fallback, so one service account can serve both Auth verification and
# existing optional push notifications. Never commit the key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-admin.json
#
# Resend sends one-time email verification/password-reset codes. Verify the
# sender domain with Resend before setting EMAIL_FROM in production.
# RESEND_API_KEY=re_...
# EMAIL_FROM=ERAS <auth@your-verified-domain.example>
# AUTH_OTP_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
# AUTH_OTP_TTL_MINUTES=10
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_MAX_ISSUES_PER_HOUR=5
# AUTH_EMAIL_SEND_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) push notifications for responders (OPTIONAL)
# ---------------------------------------------------------------------------
# Socket.IO stays the realtime channel for connected/foreground apps. FCM only
# covers responders whose app is backgrounded or not maintaining a Socket.IO
# connection. The emergency request row in PostgreSQL remains the source of
# truth: a missed push never loses a request, because GET /api/requests/compatible
# returns every pending compatible request when the responder reconnects.
#
# Without the variables below, push sending is a logged no-op and everything
# else works unchanged.
#
# Provide the Firebase service-account key EITHER as inline JSON
# (FCM_SERVICE_ACCOUNT) or as a file path (FCM_SERVICE_ACCOUNT_FILE, which
# also accepts the standard GOOGLE_APPLICATION_CREDENTIALS variable).
# NEVER commit the key file or its contents.
#
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/eras-fcm-service-account
# FCM_SEND_TIMEOUT_MS=10000

# Photon reverse geocoding (server-side; no Google Geocoding key required)
# PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
# PHOTON_USER_AGENT=ERAS/1.0 (reverse geocoding)
# PHOTON_TIMEOUT_MS=5000
