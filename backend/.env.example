# ERAS backend environment template.
# Copy to backend/.env and fill in real values. .env is git-ignored.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eras?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=5000

# ---------------------------------------------------------------------------
# Google Routes API — SERVER KEY (Part C of the location/navigation phase)
#
# This is a SEPARATE key from the browser Maps JavaScript key used by Flutter
# Web (frontend/emergency_app/web/google_maps_config.js):
#
#   browser key  -> Maps JavaScript API, Places API (New)
#                   restricted by HTTP referrer, necessarily visible in the
#                   browser.
#   server key   -> Routes API only, restricted by IP address (or left
#                   unrestricted for local development), never shipped to any
#                   frontend.
#
# It is read only by backend/src/services/routesService.js and is never
# returned by an endpoint, logged, or embedded in Dart/JS/HTML.
# ---------------------------------------------------------------------------
GOOGLE_ROUTES_API_KEY=

# Optional overrides (defaults shown).
# GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes
# GOOGLE_ROUTES_LANGUAGE_CODE=en-US
# GOOGLE_ROUTES_TIMEOUT_MS=8000

# Optional Socket.IO tuning (defaults shown).
# SOCKET_LOCATION_PERSIST_INTERVAL_MS=10000
# SOCKET_LOCATION_RATE_WINDOW_MS=1000
# SOCKET_LOCATION_MAX_UPDATES_PER_WINDOW=10
# SOCKET_SESSION_REVALIDATE_MS=30000

# Photon reverse geocoding (server-side; no Google Geocoding key required)
# PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
# PHOTON_USER_AGENT=ERAS/1.0 (reverse geocoding)
# PHOTON_TIMEOUT_MS=5000
