# ERAS backend environment template.
# Copy to backend/.env and fill in real values. .env is git-ignored.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eras?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=5000

# ---------------------------------------------------------------------------
# Navigation: ERAS does NOT compute driving routes.
#
# The operational map draws a simple direct connection line between the
# responder and the emergency (local map geometry only), and real driving
# directions are delegated to Google Maps via a universal Maps URL
# (https://www.google.com/maps/dir/?api=1). That URL requires no API key, so
# no server-side Google Routes key is needed anywhere in ERAS.
#
# The browser Maps JavaScript / Places (New) key lives in
# frontend/emergency_app/web/google_maps_config.js, not here.
# ---------------------------------------------------------------------------

# Optional Socket.IO tuning (defaults shown).
# SOCKET_LOCATION_PERSIST_INTERVAL_MS=10000
# SOCKET_LOCATION_RATE_WINDOW_MS=1000
# SOCKET_LOCATION_MAX_UPDATES_PER_WINDOW=10
# SOCKET_SESSION_REVALIDATE_MS=30000

# Photon reverse geocoding (server-side; no Google Geocoding key required)
# PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
# PHOTON_USER_AGENT=ERAS/1.0 (reverse geocoding)
# PHOTON_TIMEOUT_MS=5000
